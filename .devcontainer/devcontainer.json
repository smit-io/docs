{
  "name": "smitchoksi.com - Hugo + Go (Non-root)",
  "image": "docker.io/hugomods/hugo:debian-dart-sass-go-git-non-root",
  "features": {
    "ghcr.io/nils-geistmann/devcontainers-features/zsh": 
    {
      "ohMyZsh": true,
      "powerlevel10k": true
    },
    "ghcr.io/devcontainers/features/common-utils": {
      "userUid": 1000,
      "userGid": 1000,
      "username": "hugo"
    },
    "ghcr.io/devcontainers-extra/features/wget-apt-get": {
      "wget": true,
      "apt": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22" // default is lts
    },
    // GitHub CLI — used by Makefile gh-ci-* targets and local-ci-run token injection.
    // Run `gh auth login` once inside the container (host keyring auth does not carry over).
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // act — run GitHub Actions workflows locally (Makefile local-ci-* targets)
    "ghcr.io/dhoeric/features/act:1": {},
    // Docker CLI wired to the HOST daemon via forwarded socket — act needs this
    // to spawn job containers. No nested daemon.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // make — for the repo Makefile
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "make"
    }
  },
  // VSCode will mount the whole repo if it detects git, but the following two lines will let it know to only mount the current directory at /workspace in a dev container.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "forwardPorts": [1313],
  "remoteUser": "hugo", // or the default non-root user set by the image
  "customizations": {
    "vscode": {
      "extensions": [
        "davidanson.vscode-markdownlint",
        "budparr.language-hugo-vscode",
        "fivethree.vscode-hugo-snippets",
        "bierner.markdown-mermaid",
        "darkriszty.markdown-table-prettify",
        "DavidAnson.vscode-markdownlint",
        "shd101wyy.markdown-preview-enhanced",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-footnotes",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "TakumiI.markdowntable"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/zsh"
      }
    }
  }
  // "postCreateCommand": "git config --global oh-my-zsh.disable_auto_update true",
  // "postCreateCommand": "\"$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v1.2.1/zsh-in-docker.sh)\" -t powerlevel10k"
}